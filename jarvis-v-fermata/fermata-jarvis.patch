diff --git a/modules/jarvis/src/main/java/me/aap/fermata/addon/jarvis/JarvisFragment.java b/modules/jarvis/src/main/java/me/aap/fermata/addon/jarvis/JarvisFragment.java
new file mode 100644
index 0000000..848147a
--- /dev/null
+++ b/modules/jarvis/src/main/java/me/aap/fermata/addon/jarvis/JarvisFragment.java
@@ -0,0 +1,275 @@
+package me.aap.fermata.addon.jarvis;
+
+import static android.content.pm.PackageManager.PERMISSION_GRANTED;
+import static me.aap.fermata.util.Utils.dynCtx;
+import static me.aap.utils.async.Completed.completed;
+
+import android.Manifest;
+import android.content.Context;
+import android.content.Intent;
+import android.os.Bundle;
+import android.speech.RecognitionListener;
+import android.speech.RecognizerIntent;
+import android.speech.SpeechRecognizer;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.Toast;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+import java.util.List;
+
+import me.aap.fermata.jarvis.JarvisBridge;
+import me.aap.fermata.ui.activity.MainActivityDelegate;
+import me.aap.fermata.ui.fragment.MainActivityFragment;
+import me.aap.utils.async.FutureSupplier;
+import me.aap.utils.function.Cancellable;
+import me.aap.utils.log.Log;
+import me.aap.utils.ui.fragment.ActivityFragment;
+import me.aap.utils.ui.view.FloatingButton;
+
+/**
+ * Вкладка JARVIS: круг во весь экран. Касание круга, плавающей кнопки или
+ * кнопки «голосовое управление» (например, на руле) — сказать фразу.
+ *
+ * Порядок как при голосовом поиске Fermata: сначала фразу пробует выполнить
+ * сама Fermata («пауза», «играй…»), непонятую получает JARVIS. Ответ JARVIS
+ * только произносится — под кругом ничего не показывается.
+ *
+ * Музыка стоит на паузе, пока слушаем, ждём и произносим ответ, и
+ * возобновляется после.
+ */
+public class JarvisFragment extends MainActivityFragment
+		implements RecognitionListener, JarvisBridge.Listener {
+	@Nullable
+	private JarvisHudView hud;
+	@Nullable
+	private SpeechRecognizer recognizer;
+	private Cancellable interrupt = Cancellable.CANCELED;
+	/** Идёт разговор: слушаем, ждём JARVIS или произносим ответ. */
+	private boolean busy;
+
+	@Override
+	public int getFragmentId() {
+		return me.aap.fermata.R.id.jarvis_addon;
+	}
+
+	@Override
+	public CharSequence getTitle() {
+		return "JARVIS";
+	}
+
+	@Nullable
+	@Override
+	public View onCreateView(@NonNull LayoutInflater inflater, @Nullable ViewGroup container,
+													 @Nullable Bundle savedInstanceState) {
+		JarvisHudView v = new JarvisHudView(dynCtx(requireContext()));
+		v.setOnClickListener(x -> onCircleClick());
+		hud = v;
+		return v;
+	}
+
+	@Override
+	public void onDestroyView() {
+		stopListening();
+		hud = null;
+		super.onDestroyView();
+	}
+
+	@Override
+	public void onPause() {
+		super.onPause();
+		stopListening();
+	}
+
+	@Override
+	public void onHiddenChanged(boolean hidden) {
+		super.onHiddenChanged(hidden);
+		if (hidden) stopListening();
+	}
+
+	@Override
+	public FloatingButton.Mediator getFloatingButtonMediator() {
+		return FbMediator.instance;
+	}
+
+	/** Кнопка «голосовое управление» Fermata, пока открыта эта вкладка. */
+	@Override
+	public boolean startVoiceAssistant() {
+		listen();
+		return true;
+	}
+
+	private void onCircleClick() {
+		if (!busy) listen();
+		else if ((recognizer != null) && (phase() == HudMath.Phase.LISTEN)) recognizer.stopListening();
+	}
+
+	private void listen() {
+		if (busy || (hud == null)) return;
+		MainActivityDelegate a = getActivityDelegate();
+		Context ctx = requireContext();
+		if (!SpeechRecognizer.isRecognitionAvailable(ctx)) {
+			toast(R.string.jarvis_no_recognizer);
+			return;
+		}
+		busy = true;
+		setPhase(HudMath.Phase.APPEAR);
+		FutureSupplier<int[]> perm = a.isCarActivityNotMirror() ?
+				completed(new int[]{PERMISSION_GRANTED}) :
+				a.getAppActivity().checkPermissions(Manifest.permission.RECORD_AUDIO);
+		perm.onCompletion((r, err) -> {
+			if ((err != null) || (r == null) || (r.length == 0) || (r[0] != PERMISSION_GRANTED)) {
+				if (err != null) Log.e(err, "JARVIS tab: RECORD_AUDIO permission failed");
+				toast(me.aap.fermata.R.string.err_no_audio_record_perm);
+				done();
+				return;
+			}
+			if (!busy || (hud == null)) return;
+			startRecognizer(a);
+		});
+	}
+
+	private void startRecognizer(MainActivityDelegate a) {
+		interrupt = a.interruptPlayback();
+		SpeechRecognizer sr = SpeechRecognizer.createSpeechRecognizer(requireContext());
+		sr.setRecognitionListener(this);
+		recognizer = sr;
+		Intent i = new Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH);
+		i.putExtra(RecognizerIntent.EXTRA_LANGUAGE, a.getPrefs().getVoiceControlLang(a));
+		i.putExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL, RecognizerIntent.LANGUAGE_MODEL_FREE_FORM);
+		sr.startListening(i);
+	}
+
+	/** Прервать запись, если она идёт. Запрос, уже ушедший JARVIS, доходит до конца. */
+	private void stopListening() {
+		if (recognizer == null) {
+			if (busy && (phase() == HudMath.Phase.APPEAR)) done();
+			return;
+		}
+		destroyRecognizer();
+		done();
+	}
+
+	private void destroyRecognizer() {
+		SpeechRecognizer sr = recognizer;
+		recognizer = null;
+		if (sr != null) sr.destroy();
+	}
+
+	/** Разговор окончен: музыку — обратно, круг — в ожидание. */
+	private void done() {
+		Cancellable i = interrupt;
+		interrupt = Cancellable.CANCELED;
+		i.cancel();
+		busy = false;
+		setPhase(HudMath.Phase.IDLE);
+	}
+
+	@Override
+	public void onReadyForSpeech(Bundle params) {
+		setPhase(HudMath.Phase.LISTEN);
+	}
+
+	@Override
+	public void onBeginningOfSpeech() {
+	}
+
+	@Override
+	public void onRmsChanged(float rmsdB) {
+		if (hud != null) hud.setMicLevel(HudMath.levelFromRmsDb(rmsdB));
+	}
+
+	@Override
+	public void onBufferReceived(byte[] buffer) {
+	}
+
+	@Override
+	public void onEndOfSpeech() {
+	}
+
+	@Override
+	public void onError(int error) {
+		if (recognizer == null) return;
+		destroyRecognizer();
+		if ((error == SpeechRecognizer.ERROR_NO_MATCH) ||
+				(error == SpeechRecognizer.ERROR_SPEECH_TIMEOUT)) {
+			toast(R.string.jarvis_not_heard);
+		} else {
+			Log.e("JARVIS tab: speech recognition error ", error);
+		}
+		done();
+	}
+
+	@Override
+	public void onResults(Bundle results) {
+		if (recognizer == null) return;
+		destroyRecognizer();
+		List<String> q = (results == null) ? null :
+				results.getStringArrayList(SpeechRecognizer.RESULTS_RECOGNITION);
+		if ((q == null) || q.isEmpty() || q.get(0).trim().isEmpty()) {
+			toast(R.string.jarvis_not_heard);
+			done();
+			return;
+		}
+
+		MainActivityDelegate a = getActivityDelegate();
+		if (a.handleVoiceCommand(q)) {
+			// Команду выполнила Fermata. done() вернёт музыку, только если команда
+			// её не трогала: так устроен interruptPlayback — «пауза» останется паузой
+			done();
+		} else if (!JarvisBridge.ask(a, q.get(0), this)) {
+			toast(R.string.jarvis_not_installed);
+			done();
+		}
+	}
+
+	@Override
+	public void onPartialResults(Bundle partialResults) {
+	}
+
+	@Override
+	public void onEvent(int eventType, Bundle params) {
+	}
+
+	@Override
+	public void onThinking() {
+		if (busy) setPhase(HudMath.Phase.THINK);
+	}
+
+	@Override
+	public void onSpeaking() {
+		if (busy) setPhase(HudMath.Phase.SPEAK);
+	}
+
+	@Override
+	public void onDone() {
+		if (busy) done();
+	}
+
+	private HudMath.Phase phase() {
+		return (hud == null) ? HudMath.Phase.IDLE : hud.getPhase();
+	}
+
+	private void setPhase(HudMath.Phase p) {
+		if (hud != null) hud.setPhase(p);
+	}
+
+	private void toast(int msg) {
+		Context ctx = getContext();
+		if (ctx != null) Toast.makeText(ctx, dynCtx(ctx).getString(msg), Toast.LENGTH_SHORT).show();
+	}
+
+	private static final class FbMediator implements FloatingButton.Mediator {
+		static final FbMediator instance = new FbMediator();
+
+		@Override
+		public void enable(FloatingButton b, ActivityFragment f) {
+			b.setImageResource(me.aap.fermata.R.drawable.record_voice);
+			b.setOnClickListener(v -> ((JarvisFragment) f).startVoiceAssistant());
+			b.setOnLongClickListener(v -> ((JarvisFragment) f).startVoiceAssistant());
+		}
+	}
+}
diff --git a/modules/jarvis/src/main/java/me/aap/fermata/addon/jarvis/JarvisHudView.java b/modules/jarvis/src/main/java/me/aap/fermata/addon/jarvis/JarvisHudView.java
new file mode 100644
index 0000000..bb85c4a
--- /dev/null
+++ b/modules/jarvis/src/main/java/me/aap/fermata/addon/jarvis/JarvisHudView.java
@@ -0,0 +1,290 @@
+package me.aap.fermata.addon.jarvis;
+
+import static me.aap.fermata.addon.jarvis.HudMath.NODES;
+import static me.aap.fermata.addon.jarvis.HudMath.RINGS;
+import static me.aap.fermata.addon.jarvis.HudMath.TWO_PI;
+import static me.aap.fermata.addon.jarvis.HudMath.clamp;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.LinearGradient;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.PorterDuff;
+import android.graphics.PorterDuffXfermode;
+import android.graphics.RadialGradient;
+import android.graphics.RectF;
+import android.graphics.Shader;
+import android.graphics.SweepGradient;
+import android.graphics.Typeface;
+import android.view.View;
+
+import androidx.annotation.NonNull;
+
+/**
+ * Круг JARVIS в стиле Старка: семь колец, свечение ядра, вспышка при
+ * появлении, сетка с узлами, надпись и эквалайзер. Тот же рисунок, что в
+ * JARVIS (ui/hud/JarvisHud.kt), перенесённый с Compose на обычный Canvas:
+ * Fermata построена на View, тащить в неё Compose ради одного круга незачем.
+ *
+ * Кадры идут, только пока вид показан на экране.
+ */
+public class JarvisHudView extends View {
+	private static final int ARC = 0xFF3FD6FF;
+	private static final int ARC_SOFT = 0xFF1C7FA3;
+	private static final int INK = 0xFFCFEFFF;
+	/** В JARVIS фон полупрозрачный поверх экрана; во вкладке — свой, непрозрачный. */
+	private static final int BACKDROP = 0xFF03080D;
+	private static final float RAD_TO_DEG = (float) (180.0 / Math.PI);
+
+	private final HudMath.Animator animator = new HudMath.Animator();
+	private final float dp;
+	private final Paint fill = new Paint(Paint.ANTI_ALIAS_FLAG);
+	private final Paint plus = new Paint(Paint.ANTI_ALIAS_FLAG);
+	private final Paint stroke = new Paint(Paint.ANTI_ALIAS_FLAG);
+	private final Paint text = new Paint(Paint.ANTI_ALIAS_FLAG);
+	private final Typeface titleFace = Typeface.create(Typeface.SANS_SERIF, 600, false);
+	private final Typeface wordFace = Typeface.create(Typeface.SANS_SERIF, 500, false);
+	private final Path tickPath = new Path();
+	private final RectF box = new RectF();
+	private final String title;
+	private final String listening;
+	private final String thinking;
+
+	private HudMath.Phase phase = HudMath.Phase.IDLE;
+	private float micLevel;
+	private long start = -1L;
+	private long prev = -1L;
+	private float since;
+
+	public JarvisHudView(Context ctx) {
+		super(ctx);
+		dp = ctx.getResources().getDisplayMetrics().density;
+		title = ctx.getString(R.string.jarvis_hud_title);
+		listening = ctx.getString(R.string.jarvis_hud_listening);
+		thinking = ctx.getString(R.string.jarvis_hud_thinking);
+		setContentDescription(ctx.getString(R.string.jarvis_hud_description));
+		PorterDuffXfermode add = new PorterDuffXfermode(PorterDuff.Mode.ADD);
+		plus.setXfermode(add);
+		stroke.setXfermode(add);
+		stroke.setStyle(Paint.Style.STROKE);
+		text.setTextAlign(Paint.Align.CENTER);
+		// Свечение складывается (ADD) только с собственным фоном вида
+		setLayerType(LAYER_TYPE_HARDWARE, null);
+		setClickable(true);
+		setFocusable(true);
+	}
+
+	public HudMath.Phase getPhase() {
+		return phase;
+	}
+
+	public void setPhase(@NonNull HudMath.Phase phase) {
+		this.phase = phase;
+		if ((phase == HudMath.Phase.IDLE) || (phase == HudMath.Phase.THINK)) micLevel = 0f;
+		invalidate();
+	}
+
+	/** Громкость микрофона 0..1; сглаживает сам вид. */
+	public void setMicLevel(float level) {
+		micLevel = clamp(level, 0f, 1f);
+	}
+
+	/** Раскрыть круг заново — при каждом показе вкладки. */
+	public void restart() {
+		start = -1L;
+		prev = -1L;
+		invalidate();
+	}
+
+	@Override
+	public void onVisibilityAggregated(boolean isVisible) {
+		super.onVisibilityAggregated(isVisible);
+		if (isVisible) restart();
+	}
+
+	@Override
+	protected void onDraw(@NonNull Canvas c) {
+		long now = System.nanoTime();
+		if (start < 0L) {
+			start = now;
+			prev = now;
+		}
+		float t = HudMath.sinceSeconds(now, start);
+		float dt = HudMath.clampDt(HudMath.sinceSeconds(now, prev));
+		float real = (phase == HudMath.Phase.SPEAK) ? HudMath.speakLevel(t) : micLevel;
+		animator.advance(phase, real, t, dt);
+		prev = now;
+		since = t;
+
+		drawHud(c);
+
+		if (isShown()) postInvalidateOnAnimation();
+	}
+
+	private void drawHud(Canvas c) {
+		float w = getWidth();
+		float h = getHeight();
+		float cx = w / 2f;
+		float cy = h / 2f;
+		float s = Math.min(w, h);
+		float t = since;
+		float open = HudMath.open(t);
+		float level = animator.getLevel();
+
+		c.drawColor(BACKDROP);
+
+		// Свечение ядра
+		float coreR = HudMath.coreRadius(s, level, open) * 2.6f;
+		plus.setShader(new RadialGradient(cx, cy, coreR,
+				new int[]{argb(clamp(0.55f + level * 0.45f, 0f, 1f), 220, 250, 255),
+						withAlpha(ARC, clamp(0.35f + level * 0.4f, 0f, 1f)), withAlpha(ARC, 0f)},
+				new float[]{0f, 0.18f, 1f}, Shader.TileMode.CLAMP));
+		c.drawCircle(cx, cy, coreR, plus);
+		plus.setShader(null);
+
+		// Горизонтальная вспышка
+		float flare = HudMath.flare(phase, t, level);
+		if (flare > 0.01f) {
+			float half = s * 0.006f * (1f + flare * 2f);
+			plus.setShader(new LinearGradient(cx - s * 0.5f, 0f, cx + s * 0.5f, 0f,
+					new int[]{withAlpha(ARC, 0f), argb(clamp(flare, 0f, 1f), 230, 252, 255),
+							withAlpha(ARC, 0f)},
+					new float[]{0f, 0.5f, 1f}, Shader.TileMode.CLAMP));
+			c.drawRect(cx - s * 0.5f, cy - half, cx + s * 0.5f, cy + half, plus);
+			plus.setShader(null);
+		}
+
+		// Сетка с узлами
+		float drift = t * 0.02f;
+		stroke.setStrokeWidth(0.6f * dp);
+		for (int i = 0; i < NODES.length; i++) {
+			HudMath.Node n = NODES[i];
+			double a = n.a + drift;
+			float d = HudMath.nodeDistance(s, n, open);
+			float px = cx + (float) Math.cos(a) * d;
+			float py = cy + (float) Math.sin(a) * d;
+			HudMath.Node m = NODES[(i + 3) % NODES.length];
+			double ma = m.a + drift;
+			float md = HudMath.nodeDistance(s, m, open);
+			stroke.setColor(withAlpha(ARC_SOFT, 0.18f * open));
+			c.drawLine(px, py, cx + (float) Math.cos(ma) * md, cy + (float) Math.sin(ma) * md, stroke);
+			plus.setColor(withAlpha(ARC, 0.5f * open));
+			c.drawCircle(px, py, Math.max(0f, s * n.s * 0.15f), plus);
+		}
+
+		// Кольца
+		for (int i = 0; i < RINGS.length; i++) {
+			HudMath.Ring ring = RINGS[i];
+			float appear = HudMath.ringAppear(open, i);
+			if (appear <= 0f) continue;
+			float r = HudMath.ringRadius(s, ring, i, level, appear);
+			float base = animator.rotations[i] * TWO_PI;
+			int color = (i % 3 == 0) ? ARC_SOFT : ARC;
+			float alpha = HudMath.ringAlpha(ring, appear, level);
+			float width = ring.w * dp;
+			float glow = ((ring.w > 3f) ? 14f : 6f) * dp;
+			box.set(cx - r, cy - r, cx + r, cy + r);
+
+			for (int k = 0; k + 1 < ring.segs.length; k += 2) {
+				float a0 = base + ring.segs[k] * TWO_PI;
+				float sweep = ring.segs[k + 1] * TWO_PI * appear;
+				if (ring.dash > 0f) {
+					// Пунктир: штрих и такой же промежуток
+					float end = a0 + sweep;
+					float step = ring.dash * 2f * TWO_PI;
+					float dashLen = ring.dash * TWO_PI;
+					stroke.setColor(withAlpha(color, alpha));
+					stroke.setStrokeWidth(width);
+					for (float a = a0; a < end; a += step) {
+						c.drawArc(box, a * RAD_TO_DEG, (Math.min(end, a + dashLen) - a) * RAD_TO_DEG,
+								false, stroke);
+					}
+				} else {
+					// Свечение: широкий слабый мазок под основной линией
+					stroke.setColor(withAlpha(color, alpha * 0.22f));
+					stroke.setStrokeWidth(width + glow);
+					c.drawArc(box, a0 * RAD_TO_DEG, sweep * RAD_TO_DEG, false, stroke);
+					stroke.setColor(withAlpha(color, alpha));
+					stroke.setStrokeWidth(width);
+					c.drawArc(box, a0 * RAD_TO_DEG, sweep * RAD_TO_DEG, false, stroke);
+				}
+			}
+
+			if (ring.ticks > 0) {
+				tickPath.rewind();
+				for (int k = 0; k < ring.ticks; k++) {
+					double a = base + (k / (float) ring.ticks) * TWO_PI;
+					float len = s * ring.tickLen * ((k % 5 == 0) ? 2f : 1f);
+					float cos = (float) Math.cos(a);
+					float sin = (float) Math.sin(a);
+					tickPath.moveTo(cx + cos * r, cy + sin * r);
+					tickPath.lineTo(cx + cos * (r - len), cy + sin * (r - len));
+				}
+				stroke.setColor(withAlpha(color, alpha * 0.8f));
+				stroke.setStrokeWidth(dp);
+				c.drawPath(tickPath, stroke);
+			}
+		}
+
+		// Сканирующий луч в фазе «думаю»
+		if (HudMath.showsScan(phase)) {
+			c.save();
+			c.rotate((t * 4f * RAD_TO_DEG) % 360f, cx, cy);
+			plus.setShader(new SweepGradient(cx, cy,
+					new int[]{withAlpha(ARC, 0.35f), withAlpha(ARC, 0f), withAlpha(ARC, 0f)},
+					new float[]{0f, 0.12f, 1f}));
+			c.drawCircle(cx, cy, s * 0.3f, plus);
+			plus.setShader(null);
+			c.restore();
+		}
+
+		// Надпись в центре. Размер привязан к кругу, а не к масштабу шрифта системы
+		text.setTypeface(titleFace);
+		text.setTextSize(s * 0.05f);
+		text.setColor(withAlpha(INK, open));
+		text.setShadowLayer(12f * dp, 0f, 0f, ARC);
+		drawCentered(c, title, cx, cy - s * 0.015f);
+		text.clearShadowLayer();
+
+		String word = (phase == HudMath.Phase.LISTEN) ? listening :
+				(phase == HudMath.Phase.THINK) ? thinking : "";
+		if (!word.isEmpty()) {
+			text.setTypeface(wordFace);
+			text.setTextSize(s * 0.032f);
+			text.setColor(withAlpha(ARC, open * 0.85f));
+			drawCentered(c, word, cx, cy + s * 0.05f);
+		}
+
+		// Эквалайзер под надписью
+		if (HudMath.showsEqualizer(phase)) {
+			int bars = 13;
+			float bw = s * 0.007f;
+			float gap = s * 0.006f;
+			float x0 = cx - (bars * (bw + gap)) / 2f;
+			fill.setColor(withAlpha(ARC, 0.9f));
+			for (int k = 0; k < bars; k++) {
+				float bh = HudMath.equalizerHeight(s, level, t, k);
+				float x = x0 + k * (bw + gap);
+				float y = cy + s * 0.095f - bh / 2f;
+				c.drawRect(x, y, x + bw, y + bh, fill);
+			}
+		}
+	}
+
+	/** Строка с центром в точке (x, y) — как drawCentered в JARVIS. */
+	private void drawCentered(Canvas c, String s, float x, float y) {
+		Paint.FontMetrics fm = text.getFontMetrics();
+		c.drawText(s, x, y - (fm.ascent + fm.descent) / 2f, text);
+	}
+
+	private static int withAlpha(int color, float alpha) {
+		int a = Math.round(Color.alpha(color) * clamp(alpha, 0f, 1f));
+		return (color & 0x00FFFFFF) | (a << 24);
+	}
+
+	private static int argb(float alpha, int r, int g, int b) {
+		return Color.argb(Math.round(clamp(alpha, 0f, 1f) * 255f), r, g, b);
+	}
+}
