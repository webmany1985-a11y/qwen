+		for (int depth = 0; depth < 3; depth++) {
+			float da = (depth == 2) ? 1f : (depth == 1) ? 0.55f : 0.22f;
+			float size = (depth == 2 ? 2.4f : depth == 1 ? 1.8f : 1.3f) * dp * (1f + level * 0.7f);
