+				dots.setStrokeWidth(size);
+				dots.setColor(withAlpha((tw == 3 && depth == 2) ? INK : ARC, a));
+				c.drawPoints(bucketPts[bkt], 0, bucketSize[bkt], dots);
+			}
+		}
